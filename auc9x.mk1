d:\aurorachat\auc9x.res : d:\aurorachat\auc9x.rc .AUTODEPEND
 @d:
 cd d:\aurorachat
 *wrc auc9x.rc -bt=nt -dWIN32 -d_WIN32 -d__NT__ -i=$[:;E:\h;E:\h\nt -q -ad -&
r -fo=auc9x.res

d:\aurorachat\auc9x.exe : d:\aurorachat\credits.obj d:\aurorachat\ipsetup.ob&
j d:\aurorachat\login.obj d:\aurorachat\main.obj d:\aurorachat\rooms.obj d:\&
aurorachat\v6.obj d:\aurorachat\common.h d:\aurorachat\credits.h d:\aurorach&
at\ipsetup.h d:\aurorachat\login.h d:\aurorachat\rooms.h d:\aurorachat\v6.h &
d:\aurorachat\auc9x.res .AUTODEPEND
 @d:
 cd d:\aurorachat
 @%write auc9x.lk1 FIL credits.obj,ipsetup.obj,login.obj,main.obj,rooms.obj,&
v6.obj
 @%append auc9x.lk1 
!ifneq BLANK ""
 *wlib -q -n -b auc9x.imp 
 @%append auc9x.lk1 LIBR auc9x.imp
!endif
!ifneq BLANK "auc9x.res"
 @%append auc9x.lk1 op resource=auc9x.res
!endif
 *wlink name auc9x op inc SYS nt_win op m op maxe=25 op q op symf @auc9x.lk1

